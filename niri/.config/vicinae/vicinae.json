{
  "activate_on_single_click": true,
  "close_on_focus_loss": true,
  "pop_to_root_on_close": true,
  "escape_key_behavior": "close_window",
  "search_files_in_root": true,
  "theme": {
    "dark": {
      "icon_theme": "Adwaita"
    }
  },
  "font": {
    "rendering": "native",
    "normal": {
      "family": "Overpass",
      "size": 12.5
    }
  },
  "launcher_window": {
    "opacity": 0.8,
    "layer_shell": {
      "enabled": true,
      "keyboard_interactivity": "on_demand",
      "layer": "overlay"
    },
    "compact_mode": {
      "enabled": true
    },
    "client_side_decorations": {
      "enabled": true,
      "rounding": 20,
      "shadow_size": 12
    }
  },
  "fallbacks": [
    "shortcuts:4881d8a4-6def-44d6-8080-0e5266d60ee5",
    "files:search"
  ],
   "keybinds": {
      "toggle-action-panel": "control+B"
   },
  "providers": {
    "@ajaypremshankar/bd66a1ad-75d7-4b26-8ea7-92fcc9adf473": {
      "entrypoints": {
        "index": {
          "alias": "vim"
        }
      }
    },
    "applications": {
      "preferences": {
        "paths": [
          "/home/damian/.local/share/applications",
          "/var/lib/flatpak/exports/share/applications",
          "/usr/local/share/applications",
          "/usr/share/applications"
        ],
        "defaultAction": "focus"
      }
    },
    "clipboard": {
      "preferences": {
        "encryption": false,
        "eraseOnStartup": false,
        "monitoring": true
      },
      "entrypoints": {
        "history": {
          "preferences": {
            "defaultAction": "copy"
          }
        }
      }
    },
    "core": {
      "entrypoints": {
        "about": {
          "enabled": false
        },
        "keybind-settings": {
          "enabled": false
        },
        "manage-fallback": {
          "enabled": false
        },
        "settings": {
          "enabled": false
        },
        "sponsor": {
          "enabled": false
        }
      }
    },
    "power": {
      "enabled": false
    },
    "font": {
      "enabled": false
    },
    "raycast-compat": {
      "enabled": false
    },
    "theme": {
      "enabled": false
    },
    "wm": {
      "enabled": false
    }
  }
}
