layer-rule {
    match namespace="overview$"
    place-within-backdrop true
}

layer-rule {
    match namespace="awww"
    place-within-backdrop true
}

layer-rule {
    match namespace="noctalia-notifications"
    block-out-from "screencast"
}

layer-rule {
    match namespace="wlr_which_key"

    opacity 0.80
    background-effect {
        blur true
        xray false
    }
}

layer-rule {
    match namespace="noctalia-background-.*$"
    match namespace="vicinae"

    background-effect {
        xray false
    }

}
