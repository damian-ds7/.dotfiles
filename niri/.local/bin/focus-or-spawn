#!/usr/bin/env bash
usage() {
  echo "Usage: $0 [-t <title>] <app-id> <executable>"
  exit 1
}

TITLE=""
while getopts "t:" opt; do
  case $opt in
  t) TITLE="$OPTARG" ;;
  *) usage ;;
  esac
done
shift $((OPTIND - 1))

if [ $# -ne 2 ]; then
  usage
fi

APP_ID="$1"
EXECUTABLE="$2"

if "$HOME/.local/bin/in-niri"; then
  "$HOME/.local/bin/niri-focus-or-spawn" "$APP_ID" "$EXECUTABLE" "$TITLE"
fi
