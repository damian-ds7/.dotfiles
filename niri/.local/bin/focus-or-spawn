#!/usr/bin/env bash

# focus-or-spawn - Focus a window by app-id (and optional title), or spawn it,
# using the running compositor's implementation.
# Usage: focus-or-spawn [-t <title>] <app-id> <executable>

if [ -n "${NIRI_SOCKET:-}" ]; then
  exec "$HOME/.config/niri/scripts/focus-or-spawn" "$@"
elif [ -n "${UMBRIEL_SOCKET:-}" ]; then
  exec "$HOME/.config/umbriel/scripts/focus-or-spawn" "$@"
fi
