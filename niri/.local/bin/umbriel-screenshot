#!/usr/bin/env bash

# umbriel-screenshot - Screenshot the focused output, a region, or the focused window.
# Screen and window shots are saved like niri's and copied to the clipboard;
# region selection is handed to Noctalia.
# Usage: umbriel-screenshot <screen|area|window>

usage() {
  echo "Usage: $(basename "$0") <screen|area|window>" >&2
  exit 2
}

DIR="$HOME/Pictures/Screenshots"
FILE="$DIR/Screenshot from $(date '+%Y-%m-%d %H-%M-%S').png"

capture() {
  mkdir -p "$DIR"
  grim "$@" "$FILE" || exit 1
  wl-copy <"$FILE"
  notify-send -i "$FILE" "Screenshot captured" "Saved to $FILE and copied to clipboard"
}

case "${1:-}" in
screen)
  OUTPUT=$(umbriel outputs --json | jq -r 'first(.[] | select(.focused) | .name) // empty')
  [ -n "$OUTPUT" ] || exit 1
  capture -o "$OUTPUT"
  ;;
area)
  noctalia msg screenshot-region
  ;;
window)
  GEOMETRY=$(umbriel windows --json | jq -r 'first(.[] | select(.focused) | "\(.x),\(.y) \(.w)x\(.h)") // empty')
  [ -n "$GEOMETRY" ] || exit 1
  capture -g "$GEOMETRY"
  ;;
*) usage ;;
esac
