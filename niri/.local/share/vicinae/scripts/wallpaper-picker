#!/usr/bin/env bash
# @vicinae.schemaVersion 1
# @vicinae.title Wallpaper Picker
# @vicinae.mode silent
# @vicinae.icon icons/wallpaper.png

selected=$(find "$HOME/Pictures/Wallpapers" -type f -name '*.png' | sort |
  "$HOME"/.local/bin/dmenu-picker -p 'Pick a wallpaper...')

if [ -n "$selected" ]; then
  noctalia msg wallpaper-set "$selected"
fi
