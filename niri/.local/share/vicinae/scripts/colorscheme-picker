#!/usr/bin/env bash
# @vicinae.schemaVersion 1
# @vicinae.title Colorscheme Picker
# @vicinae.mode silent
# @vicinae.icon icons/scheme.png

themes_dir="$HOME/.config/themes"
select_script="$HOME/.local/bin/select-colorscheme"
source "$themes_dir/common.sh"

if [[ ! -d "$themes_dir" ]]; then
  echo "Themes directory not found: $themes_dir" >&2
  exit 1
fi

selected=$(printf "%s\n" "${THEMES[@]}" | sort |
  "$HOME"/.local/bin/dmenu-picker --no-quick-look -p 'Select colorscheme...')

if [ -n "$selected" ]; then
  if command -v niri >/dev/null 2>&1; then
    niri msg action do-screen-transition --delay-ms=500
  fi
  "$select_script" "$selected"
fi
