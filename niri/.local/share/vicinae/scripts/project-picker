#!/usr/bin/env bash
# @vicinae.schemaVersion 1
# @vicinae.title Project Picker
# @vicinae.mode silent
# @vicinae.icon icons/projects.png

# project-picker - open a project in a kitty window via vicinae.
# Uses project-cache-helper for discovery and MRU management.
#
# By default opens a plain kitty window running nvim in the project root.
# If the project contains a kitty session file (project.kitty-session), kitty
# is launched with that session instead, e.g.:
#
#   layout tall
#   launch --title editor nvim
#   launch --title shell
#
# See https://sw.kovidgoyal.net/kitty/overview/#sessions for the format.
projects_dir="${PROJECTS_DIR:-$HOME/Projects}"
helper="${PROJECT_CACHE_HELPER:-$HOME/.local/bin/project-cache-helper}"
session_file_name="${PROJECT_KITTY_SESSION:-project.kitty-session}"

project=$(
  "$helper" list |
    sed "s|^$projects_dir/||" |
    "$HOME"/.local/bin/dmenu-picker --no-quick-look -p 'Pick a project...'
)
[[ -z "$project" ]] && exit 0

full_path="$projects_dir/$project"
"$helper" select "$full_path" &

window_id="Neovim"
window_title="project-${project//[\/\.]/-}"
session_file="$full_path/$session_file_name"

cmd=(kitty --title="$window_title" --app-id="$window_id" --directory="$full_path")
if [[ -f "$session_file" ]]; then
  cmd+=(--session="$session_file")
else
  # login shell so nvim gets the full environment (PATH etc.)
  cmd+=(bash -l -c "exec $HOME/.local/bin/nvim")
fi

cd "$full_path" || exit 1

if [[ -x "$HOME/.local/bin/focus-or-spawn" ]]; then
  # focus-or-spawn takes a single command string, so quote it safely
  exec "$HOME/.local/bin/focus-or-spawn" -t "$window_title" "$window_id" "${cmd[*]@Q}"
else
  exec "${cmd[@]}"
fi
