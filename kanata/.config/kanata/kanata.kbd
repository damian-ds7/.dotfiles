(defcfg
  process-unmapped-keys yes
)

(defsrc
  caps ralt a s d f j k l ;
)

(defvar
  streak-count 3
  streak-time 325
  tap-timeout 200
  hold-timeout 400
  chord-timeout 50
)

(deftemplate flowtap (flow tap)
  (switch 
    ((key-timing $streak-count less-than $streak-time)) $flow break
    () $tap break
  )
)

(deftemplate charmod (char mod)
  (t! flowtap
    $char
    (tap-hold-release-timeout $tap-timeout $hold-timeout $char $mod $char reset-timeout-on-press)
  )
)

(defalias
  to-normal (layer-switch normal)
  to-main   (layer-switch main)
)

(defchords main-chords $chord-timeout
  (caps ralt) @to-normal
  (caps) caps
  (ralt) ralt
)

(defchords normal-chords $chord-timeout
  (caps ralt) @to-main
  (caps) caps
  (ralt) ralt
)

(deflayermap (main)
  caps (chord main-chords caps)
  ralt (chord main-chords ralt)
  a (t! charmod a lsft)
  s (t! charmod s lalt)
  d (t! charmod d lmet)
  f (t! charmod f lctl)
  j (t! charmod j lctl)
  k (t! charmod k lmet)
  l (t! charmod l lalt)
  ; (t! charmod ; lsft)
)

(deflayermap (normal)
  caps (chord normal-chords caps)
  ralt (chord normal-chords ralt)
)
