[user]
    name = Damian D'Souza
    email = dsouzadamian189@gmail.com

[includeIf "hasconfig:remote.*.url:https://gitlab-stud.elka.pw.edu.pl/**"]
    path = config.gitlab

[includeIf "hasconfig:remote.*.url:git@gitlab.com:*/**"]
    path = config.gitlab

[includeIf "hasconfig:remote.*.url:git@github.com:*/**"]
    path = config.github

[commit]
    gpgsign = true

[core]
    autocrlf = input
    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true

[merge]
    conflictstyle = diff3

[diff]
    colorMoved = default

[alias]
    sdiff = -c delta.features=side-by-side diff

[pull]
   rebase = true

[status]
    branch = true
    showStash = true
    showUntrackedFiles = normal

[init]
    defaultBranch = master

[url "git@github.com:damian-ds7/"]
    insteadOf = ds:

[url "git@github.com:"]
    insteadOf = gh:

[url "https://gitlab-stud.elka.pw.edu.pl/ddsouza/"]
    insteadOf = uni:

[url "https://gitlab-stud.elka.pw.edu.pl/"]
    insteadOf = uniall:

[credential]
    helper = /usr/bin/git-credential-manager
    credentialStore = secretservice

[credential "https://dev.azure.com"]
    useHttpPath = true

[credential "https://gitlab-stud.elka.pw.edu.pl"]
    provider = generic
