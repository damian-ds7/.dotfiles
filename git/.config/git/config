[user]
    name = Damian D'Souza
    email = dsouzadamian189@gmail.com

[includeIf "hasconfig:remote.*.url:https://gitlab-stud.elka.pw.edu.pl/**"]
    path = config.gitlab

[includeIf "hasconfig:remote.*.url:git@gitlab.com:*/**"]
    path = config.gitlab

[includeIf "hasconfig:remote.*.url:git@github.com:*/**"]
    path = config.github

[core]
    autocrlf = input
    pager = delta

[delta]
    side-by-side = true

[pull]
   rebase = true

[status]
    branch = true
    showStash = true
    showUntrackedFiles = normal

[init]
    defaultBranch = master

[url "git@github.com:damian-ds7/"]
    insteadOf = ds:

[url "git@github.com:"]
    insteadOf = gh:

[url "https://gitlab-stud.elka.pw.edu.pl/ddsouza/"]
    insteadOf = uni:

[url "https://gitlab-stud.elka.pw.edu.pl/"]
    insteadOf = uniall:

[credential]
    helper = 
    helper = /usr/local/sbin/git-credential-manager
    credentialStore = secretservice

[credential "https://dev.azure.com"]
    useHttpPath = true

[credential "https://gitlab-stud.elka.pw.edu.pl"]
    provider = generic
