#!/usr/bin/env bash
# project-selector - launch a project in nvim via vicinae + tmux/kitty
# Uses project-cache-helper for discovery and MRU management.
projects_dir="${PROJECTS_DIR:-$HOME/Projects}"
helper="${PROJECT_CACHE_HELPER:-$HOME/.local/bin/project-cache-helper}"

project=$(
  "$helper" list |
    sed "s|^$projects_dir/||" |
    vicinae dmenu --width 800 --no-metadata --no-quick-look -p 'Pick a project...'
)
[[ -z "$project" ]] && exit 0

full_path="$projects_dir/$project"
"$helper" select "$full_path" &

session_name="${project//[\/\.]/-}"
window_id="project.$session_name"
window_title="project-$session_name"

if [[ -f "$full_path/project-launch.sh" ]]; then
  launch_cmd="tmux new-session -d -s '$session_name' -c '$full_path' && \
              tmux send-keys -t '$session_name' '$full_path/project-launch.sh' Enter && \
              tmux attach -t '$session_name'"
else
  launch_cmd="tmux new-session -A -s '$session_name' -c '$full_path' $HOME/.local/bin/nvim"
fi

if [ -x "$HOME/.local/bin/focus-or-spawn" ]; then
  exec "$HOME/.local/bin/focus-or-spawn" "$window_id" "kitty --title=$window_title --app-id=$window_id -e bash -l -c '$launch_cmd'"
else
  exec kitty --title="$window_title" --app-id="$window_id" -e bash -l -c "$launch_cmd"
fi
