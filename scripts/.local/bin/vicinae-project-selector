#!/usr/bin/env bash

projects_dir="$HOME/Projects"
dotfiles_dir="$HOME/.dotfiles"

relative_path=$({
  find -L "$projects_dir" -maxdepth 3 -name ".git" -printf "%T@ %p\n" 2>/dev/null | sed 's/\/\.git$//'

  if [ -d "$dotfiles_dir/.git" ]; then
    printf "%s %s\n" "$(stat -c %Y "$dotfiles_dir")" "$dotfiles_dir"
  fi
} |
  sort -rn |
  cut -d' ' -f2- |
  sed -e "s|^$projects_dir/||" -e "s|^$dotfiles_dir$|dotfiles|" |
  vicinae dmenu --width 800 --no-metadata --no-quick-look -p 'Pick a project...')

[[ -z "$relative_path" ]] && exit 0

if [ "$relative_path" = "dotfiles" ]; then
  full_path="$dotfiles_dir"
else
  full_path="$projects_dir/$relative_path"
fi

session_name="${relative_path//[\/\.]/-}"
window_title="Neovim - $session_name"

launch_cmd="tmux new-session -A -s '$session_name' -c '$full_path' nvim"

if [ -x "$HOME/.cargo/bin/nirius" ]; then
  exec "$HOME/.cargo/bin/nirius" focus-or-spawn -t "^${window_title}$" -- \
    ghostty --title="$window_title" -e bash -l -c "$launch_cmd"
else
  exec ghostty --title="$window_title" -e bash -l -c "$launch_cmd"
fi
