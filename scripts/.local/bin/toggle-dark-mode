#!/usr/bin/env bash
set -eu

source "$(readlink -f "$HOME/.env")"

THEME_DIR="$HOME/.config/themes"
SCHEME=$(cat "$THEME_DIR/scheme" 2>/dev/null || echo "catppuccin")
TMUX_CONF_DIR="$HOME/.config/tmux"
TMUX_THEME_DIR="$TMUX_CONF_DIR/themes"

WLR_FILE="$HOME/.config/wlr-which-key/config.yaml"

mkdir -p "$THEME_DIR"

get_current_theme() {
  dconf read /org/gnome/desktop/interface/color-scheme || echo "'default'"
}

apply_wlr_which_key_theme() {
  [ -f "$WLR_FILE" ] || return 0
  [ -f "$THEME_DIR/current/wlr-which-key" ] || return 0

  line="$(grep -n '^# Colors' "$WLR_FILE" | head -n1 | cut -d: -f1 || true)"
  [ -n "$line" ] || return 0

  start=$((line + 1))
  end=$((line + 3))

  tmp="$(mktemp)"

  sed -e "${line}r $THEME_DIR/current/wlr-which-key" \
    -e "${start},${end}d" \
    "$WLR_FILE" >"$tmp"

  mv "$tmp" "$WLR_FILE"
}

apply_nvim_theme() {
  local scheme
  read -r scheme <"$THEME_DIR/current/nvim.conf"

  if [[ -d "$NVIM_SOCKET_DIR" ]]; then
    for sock in "$NVIM_SOCKET_DIR"/*; do
      if [[ -S "$sock" ]]; then
        nvim --server "$sock" --remote-send ":silent colorscheme $scheme<CR>"
        echo "NVIM: theme '$scheme' set for socket '$sock'" >&1
      fi
    done
  fi
}

apply_theme() {
  mode=$1
  gnome_pref=$2
  gtk_theme=$3
  scheme=$4
  qs_call=$5

  dconf write /org/gnome/desktop/interface/color-scheme "$gnome_pref"
  dconf write /org/gnome/desktop/interface/gtk-theme "'$gtk_theme'"
  ln -sfnr "$THEME_DIR/$scheme/$mode" "$THEME_DIR/current"
  echo "$mode" >"$THEME_DIR/mode"

  apply_wlr_which_key_theme &
  apply_nvim_theme &

  qs ipc call darkMode "$qs_call" >/dev/null 2>&1 &

  if [ -f "$THEME_DIR/$scheme/$mode/vicinae.conf" ]; then
    read -r vicinae_scheme <"$THEME_DIR/$scheme/$mode/vicinae.conf"
    vicinae vicinae://theme/set/"$vicinae_scheme" >/dev/null 2>&1 &
  fi

  {
    [ -x "$TMUX_THEME_DIR/reset.sh" ] && "$TMUX_THEME_DIR/reset.sh"
    (tmux info >/dev/null 2>&1 && tmux source-file "$TMUX_CONF_DIR/tmux.conf")
  } &

  killall -q -SIGUSR2 ghostty &
  killall -q -SIGUSR1 zsh &

  systemctl --user try-restart \
    waybar.service swayosd-server.service >/dev/null 2>&1 &
}

MODE=${1:-}
if [ -z "$MODE" ]; then
  if [ "$(get_current_theme)" = "'prefer-light'" ]; then
    MODE="dark"
  else
    MODE="light"
  fi
fi

if [ "$MODE" = "dark" ]; then
  apply_theme "dark" "'prefer-dark'" "adw-gtk3-dark" "$SCHEME" "setDark"
else
  apply_theme "light" "'prefer-light'" "adw-gtk3" "$SCHEME" "setLight"
fi

disown
