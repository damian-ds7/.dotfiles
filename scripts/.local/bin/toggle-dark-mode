#!/usr/bin/env bash

# Toggles between dark and light mode, or switches to the given one.
#
# Usage: toggle-dark-mode [dark|light]

source "$HOME/.config/themes/common.sh"

MODE=${1:-}
if [ -z "$MODE" ]; then
  if [ "$(current_mode)" = "dark" ]; then
    MODE="light"
  else
    MODE="dark"
  fi
fi

"$THEME_BIN/theme-set" -m "$MODE" || exit

if command -v noctalia >/dev/null 2>&1; then
  if [ "$MODE" = "dark" ]; then
    noctalia msg osd-show '{"icon":"moon","value":"Dark Mode Off"}' &>/dev/null &
  else
    noctalia msg osd-show '{"icon":"moon-off","value":"Dark Mode On","inactive":true}' &>/dev/null &
  fi
fi

disown -a
