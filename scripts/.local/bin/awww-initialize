"$HOME/.cargo/bin/awww-daemon" --namespace wallpaper &

"$HOME/.local/bin/awww-random-wallpaper" simple

get_outputs() {
  niri msg --json outputs | jq -r '.[].name'
}

previous_outputs=$(get_outputs)

niri msg --json event-stream | while IFS= read -r event; do
  if jq -e '.WorkspacesChanged' >/dev/null <<<"$event"; then
    current_outputs=$(get_outputs)

    while IFS= read -r new_output; do
      [[ -z $new_output ]] && continue
      echo "$new_output"

      "$HOME/.cargo/bin/awww" img \
        -o "$new_output" \
        -t none \
        --namespace wallpaper \
        "$HOME/Pictures/Wallpapers/current/normal.png"
    done < <(
      comm -13 \
        <(printf '%s\n' "$previous_outputs" | sort) \
        <(printf '%s\n' "$current_outputs" | sort)
    )

    previous_outputs=$current_outputs
  fi
done
