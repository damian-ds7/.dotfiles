#!/usr/bin/env bash

THEMES_DIR="$HOME/.config/themes"

source "$THEMES_DIR/common.sh"

list_themes() {
  for theme in "${THEMES[@]}"; do
    echo "- $theme"
  done
}

usage() {
  echo "Usage: $(basename "$0") <scheme>" >&2
  echo >&2
  echo "Available schemes:" >&2
  list_themes >&2
}

scheme="${1:-}"
if [[ -z "$scheme" ]]; then
  usage
  exit 2
fi

if [[ ! " ${THEMES[*]} " =~ " $scheme " ]]; then
  echo "select-colorscheme: scheme not found in THEMES array: $scheme" >&2
  echo "Valid themes are: ${THEMES[*]}" >&2
  echo >&2
  usage
  exit 1
fi

mode_file="$THEMES_DIR/mode"
if [[ ! -f "$mode_file" ]]; then
  echo "select-colorscheme: missing mode file: $mode_file" >&2
  exit 1
fi

mode="$(tr -d ' \t\r\n' <"$mode_file")"
case "$mode" in
dark | light) ;;
*)
  echo "select-colorscheme: invalid mode '$mode' in $mode_file (expected dark|light)" >&2
  exit 1
  ;;
esac

echo "$scheme" >"$THEMES_DIR"/scheme

"$HOME/.local/bin/toggle-dark-mode" "$mode"
