#!/usr/bin/env bash

source "$HOME/.config/themes/common.sh"

usage() {
  echo "Usage: $(basename "$0") <scheme>" >&2
  echo >&2
  echo "Available schemes:" >&2
  list_schemes >&2
}

scheme="${1:-}"
if [[ -z "$scheme" ]]; then
  usage
  exit 2
fi

if ! is_scheme "$scheme"; then
  echo "select-colorscheme: unknown scheme: $scheme" >&2
  echo >&2
  usage
  exit 1
fi

"$THEME_BIN/theme-set" -s "$scheme" || exit

if command -v noctalia >/dev/null 2>&1; then
  noctalia msg osd-show palette "$scheme" &>/dev/null
fi
