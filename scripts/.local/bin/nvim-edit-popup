#!/usr/bin/env bash

tmpfile="/tmp/nvimedit_temp_buf"

wtype -M ctrl -k a -k c -m ctrl

ghostty --class="com.nvim.edit" -e bash -c "wl-paste | nvim -n - +'file $tmpfile'"

sed -e '/[^[:space:]]/,$!d' -e :a -e '/^[[:space:]]*$/{$d;N;ba' -e '}' "$tmpfile" | wl-copy
rm -f "$tmpfile"

niri msg action focus-tiling

wtype -k BackSpace -M ctrl -k v -m ctrl

