#!/usr/bin/env bash

if ! tmux info >/dev/null 2>&1; then
  exit 0
fi

session=$(tmux list-sessions -F "#{session_name}" 2>/dev/null |
  vicinae dmenu --width 800 --no-metadata --no-quick-look -p 'Attach to session...')

if [ -n "$session" ]; then
  exec ghostty --title="Tmux - $session" -e bash -l -c "tmux attach-session -d -t '$session'"
fi
